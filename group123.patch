+import type { AntiBackflowEntry } from "../types";
+
+export function mockAntiBackflowData(stationId: string, date: string): AntiBackflowEntry[] {
+  const pts: AntiBackflowEntry[] = [];
+  // Threshold varies by station installed power (larger stations have higher thresholds)
+  const threshold = stationId === "bspgcl-bihar" ? 4000 : stationId === "sunsure-jp" ? 2000 : 150;
+  for (let h = 0; h < 24; h++) {
+    for (let m = 0; m < 60; m += 30) {
+      const t = `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
+      const gridPower    = h >= 8 && h < 22 ? threshold * 0.8 + Math.sin(h / 3) * threshold * 0.27 : threshold * 0.13;
+      const batteryPower = h >= 10 && h < 15 ? -(threshold * 0.53) : h >= 18 && h < 21 ? threshold * 0.67 : 0;
+      pts.push({
+        t,
+        gridPowerKw:    Math.round(gridPower    * 10) / 10,
+        batteryPowerKw: Math.round(batteryPower * 10) / 10,
+        threshold,
+      });
+    }
+  }
+  return pts;
+}
