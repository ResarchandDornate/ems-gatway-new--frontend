+import { IS_MOCK, apiFetch, mockDelay } from "../client";
+import { mockAntiBackflowData } from "../mock/strategy.mock";
+import type { AntiBackflowEntry } from "../types";
+
+const BASE = "/energy-storage-manage/strategy";
+
+export async function fetchAntiBackflow(
+  stationId: string,
+  date: string,
+  meterId?: string
+): Promise<AntiBackflowEntry[]> {
+  if (IS_MOCK) {
+    await mockDelay(300);
+    return mockAntiBackflowData(stationId, date);
+  }
+  return apiFetch(`${BASE}/antiBackflow`, {
+    params: { powerStationId: stationId, date, meterId },
+  });
+}
