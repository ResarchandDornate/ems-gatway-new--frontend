# Telemetry source profile (lib/api/metrics/profiles). northbound = the gateway.
NEXT_PUBLIC_TELEMETRY_PROFILE=northbound

# GW_BASE_URL is set in the deployment's own environment, not here — it is a
# tunnel address and does not belong in the repository. Without it the proxy
# serves the bundled reference capture and labels itself `x-gw-mode: capture`.

# Central EMS backend gateway. Not a secret — it is the site's id, and the
# backend has no endpoint that lists gateways, so a deployment without it shows
# "No gateway configured" on every page. Baked in at build (NEXT_PUBLIC_), so a
# server-side CENTRAL_GATEWAY_ID set on the host still overrides it per request
# via /api/app-config.
NEXT_PUBLIC_CENTRAL_GATEWAY_ID=bd57016e-9a31-4ed9-b107-018c36d33bc7
