# @react-three/fiber v9 and drei v10 declare a peer of React >=19. This project
# runs React 18, and they work correctly on it — but npm refuses the install on
# the declared range alone, which breaks CI and Vercel (both run `npm install`).
#
# The v8/v9 line is the nominally React-18-correct pairing and was tried first:
# its context does not survive Turbopack chunking under the App Router, so every
# hook throws "R3F: Hooks can only be used within the Canvas component!".
#
# Remove this once the app moves to React 19, which Next 16 already supports.
legacy-peer-deps=true
