{
  "name": "unityess-android-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone static build of the /k gateway UI, for wrapping with Capacitor.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
