# Read by `vite build` only; `npm run dev` keeps the empty base in .env and its
# proxy to the Next app. Committed because it is a public URL and because the
# alternative has already bitten once: a packaged build with an empty base calls
# its own bundle origin, every screen renders dashes, and nothing in the app or
# the server log says why.
VITE_API_BASE=https://ems.unityess.cloud

# Matches GW_APP_TOKEN on that deployment. Baked into the bundle, so it is a
# lock rather than a secret — but it is still not a URL, so put the real value in
# .env.production.local (gitignored) rather than here. Blank against a
# deployment that sets no token.
VITE_APP_TOKEN=
