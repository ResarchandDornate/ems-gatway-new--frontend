# Origin of the deployed Next app that hosts the gateway proxy — no trailing
# slash. The Android bundle has no server of its own, so every /api/gw call has
# to be absolute.
#
# Left empty, the app calls the same origin it was served from. That is correct
# for `npm run dev` behind a Vite proxy and for nothing else: a Capacitor build
# with this unset will request capacitor://localhost/api/gw and fail.
VITE_API_BASE=

# Dev only. With this set, `npm run dev` proxies /api/gw to the Next app on
# :3000 so the UI runs against the real gateway without CORS.
VITE_DEV_PROXY=http://localhost:3000

# Matches GW_APP_TOKEN on the deployment, which refuses requests without it.
# Baked into the bundle, so treat it as a lock rather than a secret: it keeps
# the proxy from being an open door, and is not the customer authentication
# that Phase 3 has to build. Leave blank against a deployment that sets none.
VITE_APP_TOKEN=
