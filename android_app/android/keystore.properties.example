# Copy to android/keystore.properties and fill in. That file is gitignored:
# it holds the password to the key that identifies this app to Play forever.
#
# Generate the key first — this asks for the passwords, so run it yourself:
#
#   keytool -genkeypair -v \
#     -keystore android/unityess-upload.jks \
#     -alias unityess-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Back the .jks up somewhere durable. With Play App Signing a lost upload key
# can be reset by Google, but only after a support round-trip.
storeFile=unityess-upload.jks
storePassword=
keyAlias=unityess-upload
keyPassword=
